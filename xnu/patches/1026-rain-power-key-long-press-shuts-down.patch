From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: taynotfound <marztayron@gmail.com>
Date: Sun, 15 Nov 2026 03:50:00 +0100
Subject: [PATCH] rain-1026: a long power-key press shuts the phone down

The bootloader leaves the PMIC's KPDPWR S2 reset as a reset, so holding
power rebooted straight back into iOS, and the slider's power-off hangs
before the kernel's halt path. Set the S2 reset type to shutdown at key
init so holding power powers the phone off in hardware, no software or
PC needed. PS_HOLD's reset type is set to shutdown at init as well, so
PSCI SYSTEM_OFF and ABL's "fastboot oem poweroff" stay off instead of
restarting; restart and the fastboot key combo set their own type.
Done from the key thread 60 s after boot: at key init it stopped the
USB log from coming up.
---
diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index 75e6b77..f80cb9a 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -8,6 +8,7 @@
 #include <sys/param.h>
 #include <sys/systm.h>
 #include <kern/clock.h>
+#include <mach/mach_time.h>
 #include <kern/thread.h>
 #include <kern/sched_prim.h>
 #include <machine/machine_routines.h>
@@ -115,6 +116,8 @@ keys_write(uint16_t apid, uint16_t addr, uint8_t val)
 	return false;
 }
 
+int sweet_pon_ps_hold(unsigned type);
+
 static void
 keys_reboot_fastboot(void)
 {
@@ -129,6 +132,7 @@ keys_reboot_fastboot(void)
 		*(volatile uint32_t *)(imem + 0x65cu) = 0x77665500u;
 	}
 	delay(200000);          /* the USB log gets the line out */
+	(void)sweet_pon_ps_hold(0x01);  /* warm: keeps the fastboot cookie; init set PS_HOLD to shutdown */
 	__asm__ volatile("dsb sy" ::: "memory");
 	register uint64_t x0 __asm__("x0") = 0x84000009u;      /* PSCI SYSTEM_RESET */
 	__asm__ volatile("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "memory");
@@ -146,14 +150,44 @@ keys_wait(void)
 	thread_block(THREAD_CONTINUE_NULL);
 }
 
+int sweet_pon_ps_hold(unsigned type);
+/*
+ * rain: holding the power key must switch the phone off without any software. The PMIC's KPDPWR
+ * S2 reset (PON 0x840 S1 timer, 0x841 S2 timer, 0x842 type, 0x843 bit 7 enable; Linux
+ * qpnp_config_reset) is left by the bootloader as a reset, so a long press rebooted into iOS again.
+ * Make it a shutdown (type 0x04). The slider's power-off hangs before the kernel's halt path.
+ */
+static void
+keys_power_key_shutdown(void)
+{
+	uint8_t s1 = 0, s2 = 0, type = 0, en = 0;
+	bool ok = keys_write(keys_pon_apid, 0x0843u, 0x00);     /* disable before changing the type */
+	delay(100);                                             /* >= 3 sleep-clock cycles */
+	ok = ok && keys_write(keys_pon_apid, 0x0842u, 0x04);
+	ok = ok && keys_write(keys_pon_apid, 0x0843u, 0x80);
+	bool r = keys_read(keys_pon_apid, 0x0840u, &s1) && keys_read(keys_pon_apid, 0x0841u, &s2) &&
+	    keys_read(keys_pon_apid, 0x0842u, &type) && keys_read(keys_pon_apid, 0x0843u, &en);
+	printf("RAIN KEYS: long power press = shut down: %s (s1 %#x s2 %#x type %#x en %#x, read %d)\n",
+	    ok ? "set" : "FAILED", s1, s2, type, en, r);
+	/* PS_HOLD low (PSCI SYSTEM_OFF, ABL's "fastboot oem poweroff") = shutdown too; restart paths reset it */
+	(void)sweet_pon_ps_hold(0x04);
+}
+
 static void
 keys_thread(void *arg, wait_result_t result)
 {
 	int state[3] = {0, 0, 0};
 	unsigned errors = 0, both = 0, off = 0;
+	uint64_t pmic_at = 0;
 	(void)arg;
 	(void)result;
+	/* 1026 at init stopped USB from coming up; set the PMIC once the USB log runs */
+	clock_interval_to_deadline(60, NSEC_PER_SEC, &pmic_at);
 	for (;;) {
+		if (pmic_at && mach_absolute_time() >= pmic_at) {
+			pmic_at = 0;
+			keys_power_key_shutdown();
+		}
 		uint8_t pon = 0, gpio = 0;
 		bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
 		bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
@@ -192,6 +226,7 @@ keys_thread(void *arg, wait_result_t result)
 	}
 }
 
+
 void
 sweet_keys_init(void)
 {
-- 
