From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: taynotfound <marztayron@gmail.com>
Date: Sun, 15 Nov 2026 03:20:00 +0100
Subject: [PATCH] rain-1025: log the Wi-Fi radio's PMIC rails

Wi-Fi's cap request fails (err 119) on every boot since a power cycle,
even with the image that had working Wi-Fi. Theory: only Android turns
the WCN39xx LDOs on and warm resets kept them. Log on/off, ready,
voltage and owner of PM6125 L5..L23 when the first cap answer arrives.
---
diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index 0df049a..75e6b77 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -31,6 +31,7 @@ void sweet_keys_init(void);
 
 static vm_offset_t keys_core, keys_obs, keys_cnfg;
 static uint16_t keys_pon_apid = KEYS_NO_APID, keys_gpio_apid = KEYS_NO_APID;
+static uint32_t keys_apids;     /* rain: for sweet_pmic_wifi_rails */
 static uint32_t keys_version, keys_last_status;
 static bool keys_started;
 static int keys_sleep_chan;
@@ -221,6 +222,7 @@ sweet_keys_init(void)
 		    keys_version, count);
 		return;
 	}
+	keys_apids = count;
 	keys_pon_apid = keys_find_apid(0x008, count);
 	keys_gpio_apid = keys_find_apid(0x0c4, count);
 	uint8_t pon = 0, gpio = 0, mode = 0, en = 0, subtype = 0;
@@ -270,4 +272,43 @@ sweet_pon_ps_hold(unsigned type)
 	return ok ? 0 : -1;
 }
 
+/*
+ * rain: diagnostic. Are the WCN39xx radio's PM6125 LDOs on? (bengal icnss: vdd-cx-mx L8, vdd-1.8-xo L16,
+ * vdd-1.3-rfa L17, vdd-3.3-ch0 L23; a few neighbours for comparison.) LDOn is peripheral 0x40+n-1:
+ * STATUS1 0x08 (bit 7 ready), EN_CTL 0x46 (bit 7 on), VSET 0x40/0x41 (mV). Owner = the arbiter's EE for it.
+ * Wi-Fi's cap request failed (err 119) on every boot after a power cycle: the theory is that only Android
+ * turns these on and warm resets kept them.
+ */
+void sweet_pmic_wifi_rails(const char *when);
+void
+sweet_pmic_wifi_rails(const char *when)
+{
+	static const uint8_t ldo[] = { 5, 7, 8, 9, 12, 16, 17, 19, 22, 23 };
+	char line[512];
+	size_t at = 0;
+
+	if (keys_apids == 0) {
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(ldo); i++) {
+		uint16_t ppid = (uint16_t)(0x40 + ldo[i] - 1);
+		uint16_t apid = keys_find_apid(ppid, keys_apids);
+		uint8_t st = 0, en = 0, lo = 0, hi = 0;
+		if (apid == KEYS_NO_APID || !keys_read(apid, (uint16_t)(ppid << 8 | 0x08), &st) ||
+		    !keys_read(apid, (uint16_t)(ppid << 8 | 0x46), &en)) {
+			at += (size_t)snprintf(line + at, sizeof(line) - at, " L%u ?", ldo[i]);
+			continue;
+		}
+		(void)keys_read(apid, (uint16_t)(ppid << 8 | 0x40), &lo);
+		(void)keys_read(apid, (uint16_t)(ppid << 8 | 0x41), &hi);
+		at += (size_t)snprintf(line + at, sizeof(line) - at, " L%u %s%s %umV o%u", ldo[i],
+		    (en & 0x80) ? "on" : "off", (st & 0x80) ? "" : "(nr)", (unsigned)(hi << 8 | lo),
+		    keys_rd(keys_cnfg, 0x700u + 4u * apid) & 7u);
+		if (at >= sizeof(line)) {
+			break;
+		}
+	}
+	printf("RAIN PMIC (%s):%s\n", when, line);
+}
+
 #endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/iokit/Kernel/arm/TopazModem.cpp b/iokit/Kernel/arm/TopazModem.cpp
index cdd7051..0febda4 100644
--- a/iokit/Kernel/arm/TopazModem.cpp
+++ b/iokit/Kernel/arm/TopazModem.cpp
@@ -24,6 +24,7 @@
 #include <libkern/crc.h>
 #include <sys/param.h>
 #include <sys/errno.h>
+extern "C" void sweet_pmic_wifi_rails(const char *when);
 
 extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
 
@@ -3430,6 +3431,9 @@ wlfw_rx(const uint8_t *d, uint32_t len)
 		break;
 	case WLFW_CAP:
 		LOG("t=%u ms: wlfw: cap %s err %u (try %u)", g_ms, ok ? "ok" : "FAILED", err, w_cap_tries + 1);
+		if (w_cap_tries == 0) {
+			sweet_pmic_wifi_rails(ok ? "cap ok" : "cap failed");
+		}
 		if (ok) {
 			w_on_cap(d, len);
 		} else {
